# Campaign server environment (all optional; the server boots and degrades
# gracefully without any of them). Never commit real values.

# Port and static build (defaults: 3401, ./dist)
#PORT=3401
#CAMPAIGN_DIST=

# SQLite path (default: server/data/campaign.db)
#CAMPAIGN_DB_PATH=

# App session JWT signing secret (local Electioneer sessions)
#JWT_SECRET=

# Ops backdoor for minting activation codes
#ADMIN_SECRET=

# Lakeside Auth broker (central AHD/Discord identity service). Required for
# /api/lakeside/login and /api/lakeside/handoff — without these, those routes
# bounce players to the AHD login page.
#LAKESIDE_AUTH_BASE_URL=https://auth.lakesidegames.net
#LAKESIDE_AUTH_INTERNAL_TOKEN=

# Optional: AHD-sibling origin for the browser /auth/ahd redirect so the game
# cookie (scoped to .ahousedividedgame.com) is visible. Defaults to
# LAKESIDE_AUTH_BASE_URL when unset.
#LAKESIDE_AUTH_AHD_ORIGIN=https://auth.ahousedividedgame.com

# Bearer token for /api/internal/* (account portal on the same box)
#INTERNAL_TOKEN=

# Stripe Checkout. Without these, POST /api/checkout answers 503 and the
# webhook rejects everything.
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=

# Canonical public base URL for redirects when the request Origin is not in
# the allowlist (default: https://sim.ahousedividedgame.com)
#BASE_URL=

# Dedicated shared-store bridge credential. Must match Lakeside accounts.
#MOV_STORE_BRIDGE_TOKEN=
#LAKESIDE_STORE_URL=https://lakesidegames.net/account/api/store
